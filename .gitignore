# Repo-specific ignores. OS/editor noise, .env*, and private-key
# patterns below were originally seeded from the hub's `common`
# block, but this repo has no active managed-file-sync workflow —
# treat everything in this file as plain repo-local content.

# Local dev artefacts (repo-specific)
/tmp-*
test/output/

# OS noise
.DS_Store
Thumbs.db
._*

# Editor / IDE noise
.vscode/
.idea/
*.swp
*.swo
*~

# Local env files (NEVER commit credentials)
.env
.env.*
!.env.example
.envrc
.direnv/

# TLS / private keys
.secrets/
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.*
